{
  "buildCommand": "pnpm --filter @workspace/chocolates-dom-jose run build && pnpm --filter @workspace/api-server exec node build-vercel.mjs",
  "installCommand": "pnpm install",
  "outputDirectory": "artifacts/chocolates-dom-jose/dist/public",
  "regions": ["cdg1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/checkout/(.*)", "destination": "/app-shell.html" }
  ],
  "headers": [
    {
      "source": "/catalogo-dom-jose.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"catalogo-dom-jose.pdf\"" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/cart-recovery", "schedule": "0 9 * * *" }
  ]
}
